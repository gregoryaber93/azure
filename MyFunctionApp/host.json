{
    "version": "2.0",
    "extensions": {
        "queues": {
            "messageEncoding": "base64"
        }
    },
    "logging": {
        "logLevel": {
            "default": "Warning",
            "Microsoft": "Warning",
            "System": "Warning",
            "Host.Aggregator": "Error",
            "Host.Results": "Warning",
            "Function": "Warning",
            "Function.ProcessOrderQueueV2.User": "Information"
        },
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "excludedTypes": "Request"
            },
            "enableLiveMetricsFilters": true
        }
    }
}